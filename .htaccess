# =====================================================================
# EcoBuesaco · Seguridad del servidor (Apache)
# =====================================================================

# No listar carpetas
Options -Indexes

# Página de inicio
DirectoryIndex index.html

# Archivos ocultos (.htaccess, .gitignore, .env...) no se pueden descargar
<FilesMatch "^\.(?!well-known)">
    Require all denied
</FilesMatch>

# Archivos internos que nunca deben verse desde el navegador
<FilesMatch "\.(sql|md|log|bak|ini|sh)$">
    Require all denied
</FilesMatch>

# Cabeceras de seguridad (requiere mod_headers, activo por defecto en XAMPP)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
</IfModule>

# Compresión de texto
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# Caché de las fotos subidas (los nombres son aleatorios, nunca cambian)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png  "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
</IfModule>